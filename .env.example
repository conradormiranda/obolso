# =====================================================================
# O Bolso — variáveis de ambiente (SEM valores reais).
# Produção: configure SOMENTE no painel da Vercel.
# Local: copie para .env.local (ignorado pelo git).
# =====================================================================

# --- Supabase (somente URL + anon key; o app NUNCA usa a service_role) ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=

# --- App ---
# Origem exata do app (usada na checagem de Origin/CSRF e nos links de e-mail)
APP_ORIGIN=http://localhost:3000
# E-mails autorizados (para a recuperação de senha), separados por vírgula
ALLOWED_EMAILS=
# Segredos aleatórios de 32+ caracteres:  openssl rand -base64 48
SESSION_SECRET=
RATE_LIMIT_SECRET=

# --- Cloudflare Turnstile ---
# Em desenvolvimento use as chaves de teste públicas da Cloudflare:
#   site key 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Resend (alerta de login em dispositivo novo). Obrigatório quando APP_ORIGIN é https ---
RESEND_API_KEY=
ALERT_EMAIL_FROM="O Bolso <alertas@seu-dominio>"

# =====================================================================
# Apenas para testes de segurança/E2E (arquivo .env.test.local), projeto de DEV.
# NUNCA coloque a service_role de produção aqui nem na Vercel.
# =====================================================================
# TEST_SUPABASE_PROJECT_REF=
# TEST_SUPABASE_SERVICE_ROLE_KEY=
